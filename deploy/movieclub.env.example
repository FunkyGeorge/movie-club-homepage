# Copy this file to /etc/movieclub.env, then replace every placeholder.
# Keep it readable only by root and the movieclub service user.

DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=YOUR_DOMAIN,www.YOUR_DOMAIN
CSRF_TRUSTED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN
# Set to true after HTTPS is working.
DJANGO_SECURE_SSL_REDIRECT=false
CLUB_TIMEZONE=UTC

DB_NAME=movieclub
DB_USER=movieclub
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

BOT_API_TOKEN=replace-me
TMDB_READ_ACCESS_TOKEN=replace-me
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
CLUB_JOIN_URL=

PYTHONUNBUFFERED=1
