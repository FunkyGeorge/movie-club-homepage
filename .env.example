# Django
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CLUB_TIMEZONE=UTC

# Database
# Project-local Postgres (make db-start) uses 127.0.0.1:5433.
# If you import nix/system.nix instead, use DB_HOST=/run/postgresql and DB_PORT=5432.
DB_NAME=movieclub
DB_USER=george
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433

# Shared secret used by the Discord bot when calling POST /api/weeks/.
BOT_API_TOKEN=replace-me

# TMDB v4 API Read Access Token.
TMDB_READ_ACCESS_TOKEN=
